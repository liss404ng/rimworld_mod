<?xml version="1.0" encoding="utf-8"?>
<!--
  Stellar Provisions MR-7 炖时蔬（烹饪配方 RecipeDef）
  ============================================================================
  验证状态：已验证（对照 RimWorld 1.7.4981 原版：
    Data/Core/Defs/RecipeDefs/Recipes_Meals.xml
    CookMealBase 抽象 :4-28；CookMealSimple 字段基准 :32-58；
    CookMealFine_Veg 素食 0.75 营养基准与禁用 MeatRaw 的 fixedIngredientFilter :131-157；
    素食过滤继承追加写法即 CookMealFine_Veg :148-152）
  AI 辅助生成
  ============================================================================
  适用版本：RimWorld 1.7
  原版参考路径：Data/Core/Defs/RecipeDefs/Recipes_Meals.xml
  ParentName 继承链：CookMealBase(:4, 抽象)
    自带 fixedIngredientFilter(FoodRaw + 禁 AllowPlantFood)、
    defaultIngredientFilter(排除受精蛋/人肉/巨型蛛肉/虫胶/扭曲肉)、workSkill Cooking

  关键设计决策：
    1. ingredientValueGetterClass = IngredientValueGetter_Nutrition：
       count 按「营养值」计（0.75 = 原版精致素食餐基准），不是按件数。
    2. 素炖定位：食材过滤 PlantFoodRaw + fixedIngredientFilter 追加禁 MeatRaw
       （原版 CookMealFine_Veg :148-152 同款继承追加写法）。
    3. 【价目对齐简单餐档，2026-11 修正】workAmount 450 / displayPriority 100
       与原版 CookMealSimple 完全一致（它省略 workAmount 即取默认 450）。
       原先的 600 / 150 是「介于简单餐与精致餐之间」的自造档位，原版阶梯上
       并不存在，已放弃。批量配方按原版规律 = 单次 + 10。
       保留 skillRequirements Cooking 4 作为产品差异（原版简单餐无门槛）；
       如需与简单餐完全等同，删掉该块即可。
    4. recipeUsers 挂台：燃料炉/电炉/营火。RecipeDef 级 recipeUsers 是合法写法
       （原版裁缝台 ElectricTailoringBench/HandTailoringBench 自身无 <recipes> 块，
       全靠 RecipeDef.recipeUsers 挂上 Make_Patchleather 等配方）。
       营火在原版只做简单餐与干肉饼，本配方允许营火属刻意的设计放宽。
    5. products 是字典写法：子元素名 = 产物 defName。
  ============================================================================
-->
<Defs>

  <RecipeDef ParentName="CookMealBase">
    <defName>TST_Recipe_MR7_VegetableStew</defName>
    <label>cook MR-7 vegetable stew</label>
    <description>Prepare Stellar Provisions product MR-7 from fresh plant ingredients. Simmering time is company policy.</description>
    <jobString>Cooking MR-7 vegetable stew.</jobString>

    <!-- 与原版 CookMealSimple 同值（原版省略 workAmount，默认即 450） -->
    <workAmount>450</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>

    <!-- 允许不同食材混炖；count 按食材营养值计 -->
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>

    <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>

    <ingredients>
      <li>
        <filter>
          <customSummary>vegetables</customSummary>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>0.75</count>
      </li>
    </ingredients>

    <!-- 素炖：在继承的过滤器上追加禁荤（原版同款继承追加写法） -->
    <fixedIngredientFilter>
      <disallowedCategories>
        <li>MeatRaw</li>
      </disallowedCategories>
    </fixedIngredientFilter>

    <recipeUsers>
      <li>FueledStove</li>
      <li>ElectricStove</li>
      <li>Campfire</li>
    </recipeUsers>

    <!-- 产物：字典写法，元素名 = 产物 defName -->
    <products>
      <TST_Food_MR7_VegetableStew>1</TST_Food_MR7_VegetableStew>
    </products>

    <displayPriority>100</displayPriority>
  </RecipeDef>

</Defs>
